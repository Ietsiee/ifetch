pkgname=ifetch
pkgver=1.0.5
pkgrel=1
pkgdesc="Ifetch is a simple tool that prints out system information"
arch=('any')
url="https://github.com/Ietsiee/ifetch"
license=('MIT')
depends=('curl')
source=("https://github.com/Ietsiee/ifetch/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/ifetch-main"

    chmod +x ifetch-launcher.sh
    chmod +x ifetch.sh
    chmod +x modules/*

    mkdir -p "$pkgdir/usr/bin"
    cp ifetch-launcher.sh "$pkgdir/usr/bin/ifetch"

    mkdir -p "$pkgdir/etc/ifetch"
    cp ifetch.sh "$pkgdir/etc/ifetch/ifetch.sh"
    cp ifetch.config "$pkgdir/etc/ifetch/ifetch.config"
    cp help.txt "$pkgdir/etc/ifetch/help.txt"
    cp logo.txt "$pkgdir/etc/ifetch/logo.txt"

    cp -r modules "$pkgdir/etc/ifetch/"
    cp -r presets "$pkgdir/etc/ifetch/"
}
