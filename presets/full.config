# ifetch.config
# full ifetch preset

module=logo --color cyan
module=separator

module=os --color red
module=hostname --color yellow
module=kernel --color red
module=arch --color magenta
module=command "cd && pwd"
module=uptime --color 
module=timezone --color blue
module=user
module=shell --color yellow

module=cpu
module=ram -g --color blue
module=disk -t --color cyan
module=temperature
module=process --color magenta

module=network --color blue
module=dns --color blue

module=tty --color red
module=packages --color blue

module=crypto BTC --color blue
module=weather Rotterdam

module=echo "Message: Hello :3" --color red